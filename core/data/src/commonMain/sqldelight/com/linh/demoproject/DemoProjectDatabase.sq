CREATE TABLE IF NOT EXISTS UserEntity(
    id INTEGER NOT NULL PRIMARY KEY,
    login TEXT UNIQUE NOT NULL,
    avatar_url TEXT NOT NULL,
    html_url TEXT NOT NULL,
    name TEXT,
    location TEXT,
    followers INTEGER,
    following INTEGER,
    bio TEXT
);

CREATE INDEX userEntity_login ON UserEntity(login);

insertUser:
INSERT OR REPLACE INTO UserEntity(id, login, avatar_url, html_url, name, location, followers, following, bio) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getUsersPaged:
SELECT * FROM UserEntity ORDER BY id ASC LIMIT :limit OFFSET :offset;

countUsers:
SELECT COUNT(*) FROM UserEntity;

getUsers:
SELECT * FROM UserEntity;

getUserByLogin:
SELECT * FROM UserEntity WHERE login = ?;

CREATE TABLE IF NOT EXISTS RemoteKeyEntity(
    data_type TEXT NOT NULL PRIMARY KEY,
    next_key INTEGER
);

insertRemoteKey:
INSERT OR REPLACE INTO RemoteKeyEntity(data_type, next_key) VALUES (?, ?);

getRemoteKeyByDataType:
SELECT * FROM RemoteKeyEntity WHERE data_type = ?;

deleteRemoteKeyByDataType:
DELETE FROM RemoteKeyEntity WHERE data_type = ?;